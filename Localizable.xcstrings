    "deleteAccount_ContentText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نأسف لرؤيتك ترحل!\nسيؤدي هذا إلى حذف حسابك في Monty eSIM. ومع ذلك، سيظل ملف eSIM الخاص بك نشطًا وستتمكن من استخدام خط eSIM الخاص بك خلال فترة صلاحيته."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are sorry to see you go!\nThis will delete your Monty eSIM account. However, your eSIM profile will remain active and you will be able To use your eSIM line during its validity period."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes désolés de vous voir partir !\nCela supprimera votre compte Monty eSIM. Cependant, votre profil eSIM restera actif et vous pourrez utiliser votre ligne eSIM pendant sa période de validité."
          }
        }
      }
    },
