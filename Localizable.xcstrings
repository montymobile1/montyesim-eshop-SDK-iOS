    "compatibility.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في حال كان جهازك يدعم eSIM، ستتمكن من عرض رقم تعريف eSIM الفريد لجهازك (EID)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensure your device supports eSIM functionality before making a purchase. Dial *#06#; in case your device is eSIM capable, you should be able to view your device's eSIM unique identification number (EID)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que votre appareil supporte l'eSIM. Composez *#06# pour voir le numéro EID."
          }
        }
      }
    },
