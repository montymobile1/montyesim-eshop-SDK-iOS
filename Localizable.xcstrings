    "userGuideView_androidStep1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدث إلى فريق الخبراء لإعداد خطة الدفع الآجل. تحتاج إلى تقديم EID الخاص بجهازك إلى الخبير لتحديث حسابك. سيتم تسليم رمز الاستجابة السريعة إليك عبر البريد الإلكتروني للتفعيل. ولمعرفة كيفية الوصول إلى ماسح رمز الاستجابة السريعة وإضافة السطر الجديد، اتبع الخطوات التالية:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talk to your Team of Experts to set up your postpaid plan. You will need to provide your device EID to the Expert to update your account. A QR code will be delivered to you via email for activation. To learn how to access your QR code scanner and add your new line, follow these steps:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactez votre équipe d’experts pour configurer votre forfait postpayé. Vous devrez fournir l’EID de votre appareil à l’expert pour mettre à jour votre compte. Un code QR vous sera envoyé par e-mail pour l’activation. Pour apprendre à accéder au scanner de codes QR et ajouter votre nouvelle ligne, suivez ces étapes :"
          }
        }
      }
    },
    "userGuideView_androidStep2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى الشاشة الرئيسية. لفتح القائمة، مرر سريعًا لأعلى على الشاشة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to the Home screen. To open the menu, swipe up on the screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez à l’écran d’accueil. Pour ouvrir le menu, faites glisser vers le haut sur l’écran."
          }
        }
      }
    },
    "userGuideView_androidStep3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى اليمين، واختر الإعدادات."
