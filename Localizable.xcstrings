    "userGuideView_iosStep1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدث إلى فريق الخبراء لإعداد خطة الدفع الآجل. تحتاج إلى تقديم EID الخاص بجهازك إلى الخبير لتحديث حسابك. لا يلزم رمز الاستجابة السريعة إلا إذا لم يتم استلام إشعار الاكتشاف التلقائي وسيتم تسليمه إليك عبر البريد الإلكتروني للتنشيط. ولمعرفة كيفية الوصول إلى ماسح رمز الاستجابة السريعة وإضافة السطر الجديد، اتبع الخطوات التالية:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talk to your Team of Experts to set up your postpaid plan. You will need to provide your device EID to the Expert to update your account. A QR code is only needed if the auto-discovery notification is not received and will be delivered to you via email for activation. To learn how to access your QR code scanner and add your new line, follow these steps:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactez votre équipe d’experts pour configurer votre forfait postpayé. Vous devrez fournir l’EID de votre appareil à l’expert pour mettre à jour votre compte. Un code QR est nécessaire uniquement si la notification de découverte automatique n’est pas reçue et vous sera envoyé par e-mail pour l’activation. Pour apprendre à accéder au scanner de codes QR et ajouter votre nouvelle ligne, suivez ces étapes :"
          }
        }
      }
    },
    "userGuideView_iosStep2" : {
