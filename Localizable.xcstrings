    "shareReferral_contentText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بمجرد أن يقوم أصدقاؤك بشراء أول شريحة eSIM باستخدام رمز الإحالة الخاص بك، ستحصل على مكافأة بنسبة {amount} في محفظة Monty eSIM الخاصة بك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once your friends successfully purchase their first eSIM using your referral code, you'll receive a {amount} reward in your wallet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois que vos amis auront acheté leur première eSIM avec votre code, vous recevrez une récompense de {amount} dans votre portefeuille."
          }
        }
      }
    },
    "shareReferral_fullLinkText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا، هل جربت eSIM؟ احصل على {amount} خصم على حزمة بيانات eSIM الأولى من مونتي eSIM. استخدم الرمز {code} وقم بتطبيقه عند الدفع.{link}"
